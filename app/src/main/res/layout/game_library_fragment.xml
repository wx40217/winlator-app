<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/LibraryRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/librarySurface">
    <androidx.core.widget.NestedScrollView android:id="@+id/LibraryControls"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp">
        <androidx.appcompat.widget.SearchView android:id="@+id/LibrarySearch"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:background="@drawable/library_card" app:iconifiedByDefault="false"
            app:queryHint="@string/library_search" app:queryBackground="@android:color/transparent" />
        <LinearLayout android:id="@+id/LibraryFilters" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <com.google.android.material.chip.ChipGroup android:id="@+id/LibraryCollection"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
                <com.google.android.material.chip.Chip android:id="@+id/LibraryAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/library_all" android:textColor="?attr/libraryText"
                    android:checkable="true" android:checked="true" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/LibraryFavorites"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/favorites" android:textColor="?attr/libraryText"
                    android:checkable="true" app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
            <Spinner android:id="@+id/LibraryContainer" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
                android:contentDescription="@string/library_all_containers" />
        </LinearLayout>
        <TextView android:id="@+id/LibraryPath" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textColor="?attr/librarySecondaryText" android:textSize="13sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/LibraryRecent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/LibraryText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/library_recent"
                android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="8dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/LibraryRecentList"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/LibrarySection" style="@style/LibraryText"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/library_all_games" android:textStyle="bold" />
            <TextView android:id="@+id/LibraryCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?attr/librarySecondaryText" />
            <ProgressBar android:id="@+id/LibraryLoading" style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
                android:visibility="gone" android:contentDescription="@string/library_loading" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:id="@+id/LibraryBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/RecyclerView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="12dp"
            android:clipToPadding="false" android:scrollbars="vertical" />
        <LinearLayout android:id="@+id/LibraryEmpty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:padding="24dp" android:visibility="gone">
            <TextView android:id="@+id/TVEmptyText" style="@style/LibraryText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/LibraryEmptyHint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp"
                android:textColor="?attr/librarySecondaryText" android:textSize="14sp" />
            <Button android:id="@+id/LibraryEmptyAction" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" />
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/BTPaste"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end|bottom" android:contentDescription="@string/paste"
            android:src="@drawable/icon_paste" android:layout_margin="16dp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
